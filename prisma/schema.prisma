generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  password              String
  documents             Json?          @default("[]")
  businessIdentity      String?
  brandVoice            String?
  googleTokens          Json?
  whatsappToken         String?
  whatsappPhoneNumberId String?
  whatsappWabaId        String?

  // Facebook Messenger
  facebookPageId        String?
  facebookPageName      String?
  facebookPageToken     String?
  facebookConnected     Boolean        @default(false)

  tickets               Ticket[]
  documentChunks        DocumentChunk[]
  chatSessions          ChatSession[]

  // Live Chat
  livechatToken         String?        @unique
  livechatEnabled       Boolean        @default(false)

  // Stripe billing
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  plan                  String         @default("startup")

  // Channel preferences
  gmailEnabled          Boolean        @default(true)

  // Automation settings
  aiAutoDrafting        Boolean        @default(true)
  autoClassification    Boolean        @default(true)
  sentimentTracking     Boolean        @default(false)

  // Sidebar badge tracking
  lastSeenInboxAt       DateTime?
  lastSeenEscalAt       DateTime?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model DocumentChunk {
  id        String                       @id @default(uuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  docName   String
  content   String
  embedding Unsupported("vector(1536)")
  createdAt DateTime                     @default(now())

  @@index([userId])
  @@index([userId, docName])
}

model Ticket {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId       String
  threadId         String?
  customerName     String
  customerEmail    String?
  phoneNumber      String?
  subject          String?
  content          String
  channel          String    @default("gmail")
  status           String    @default("new")
  sentiment        String    @default("Neutral")
  category         String    @default("General")
  urgency          Int       @default(1)
  escalationReason String?
  receivedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, externalId])
  @@index([userId, status])
  @@index([userId, receivedAt])
  @@index([userId, channel])
}

// ── Live Chat ─────────────────────────────────────────────────────────────────
model ChatSession {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId   String
  visitorName String        @default("Visitor")
  status      String        @default("active")  // active | resolved
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@index([userId])
  @@index([userId, status])
  @@index([visitorId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "visitor" | "agent"
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}
