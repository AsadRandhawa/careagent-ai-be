generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  password              String
  documents             Json?           @default("[]")
  businessIdentity      String?
  brandVoice            String?
  googleTokens          Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  whatsappPhoneNumberId String?
  whatsappToken         String?
  whatsappWabaId        String?
  gmailEnabled          Boolean         @default(true)
  lastSeenEscalAt       DateTime?
  lastSeenInboxAt       DateTime?
  aiAutoDrafting        Boolean         @default(true)
  autoClassification    Boolean         @default(true)
  sentimentTracking     Boolean         @default(false)
  plan                  String          @default("startup")
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  livechatEnabled       Boolean         @default(false)
  livechatToken         String?         @unique
  facebookConnected     Boolean         @default(false)
  facebookPageId        String?
  facebookPageName      String?
  facebookPageToken     String?
  facebookEnabled       Boolean         @default(true)
  instagramBusinessId   String?
  instagramConnected    Boolean         @default(false)
  instagramEnabled      Boolean         @default(true)
  instagramUsername     String?
  chatSessions          ChatSession[]
  documentChunks        DocumentChunk[]
  tickets               Ticket[]
}

model DocumentChunk {
  id        String                @id @default(uuid())
  userId    String
  docName   String
  content   String
  embedding Unsupported("vector")
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, docName])
}

model Ticket {
  id               String    @id @default(uuid())
  userId           String
  externalId       String
  threadId         String?
  customerName     String
  customerEmail    String?
  phoneNumber      String?
  subject          String?
  content          String
  channel          String    @default("gmail")
  status           String    @default("new")
  sentiment        String    @default("Neutral")
  category         String    @default("General")
  urgency          Int       @default(1)
  receivedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  escalationReason String?
  Message          Message[]
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@unique([userId, channel, threadId])
  @@index([userId, status])
  @@index([userId, receivedAt])
  @@index([userId, channel])
}

model ChatSession {
  id          String        @id @default(uuid())
  userId      String
  visitorId   String
  visitorName String        @default("Visitor")
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([visitorId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  ticketId   String
  externalId String?
  direction  String
  content    String
  senderName String?
  createdAt  DateTime @default(now())
  Ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, externalId])
  @@index([ticketId, createdAt])
}
